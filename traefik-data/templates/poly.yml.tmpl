# TEMPLATE — do not edit the rendered copy in ../dynamic/poly.yml by hand.
# On `docker compose up`, the `config` service renders this file into
# ../dynamic/poly.yml, filling these placeholders from .env:
#   __DOMAIN__          domain with dots escaped as [.]  (for the HostRegexp rules)
#   __DOMAIN_RAW__      raw domain                       (for the wildcard cert SANs)
#   __GEO_BLACKLIST__   false = allowlist / true = blocklist   (GeoBlock)
#   __GEO_COUNTRIES__   comma-separated ISO codes               (GeoBlock, flow list)
#   __CROWDSEC_LAPI_KEY__  bouncer API key for the CrowdSec plugin
#
# This box TERMINATES TLS (bridging): it decrypts the client's TLS, runs L7
# checks (geofence + CrowdSec), then opens a SECOND TLS connection to the home
# server (which still terminates its own TLS). The VPS holds a wildcard cert for
# *.DOMAIN (Let's Encrypt via DNS-01); the home server keeps its own certs.
#
# The second hop no longer rides Tailscale. The home box dials OUT to
# wstunnel.DOMAIN (wss/443) and opens a reverse tunnel; Traefik reaches
# home through wstunnel:8443. The tunnel router below is locked with edge mTLS
# (see the `tls.options` block at the bottom) so only the home client's cert can
# establish it.

http:
  routers:
    # wstunnel control plane. The home client connects here over wss/443; Traefik
    # terminates TLS, REQUIRES a valid client cert (mtls-tunnel options), then
    # forwards the plain-ws upgrade to the wstunnel server container. Higher
    # priority than the `poly` catch-all below, whose HostRegexp would otherwise
    # also match this host. No CrowdSec here: it's a single long-lived upgrade
    # from a known peer, already pinned by mTLS.
    wstunnel:
      entryPoints:
        - websecure
      rule: 'Host(`wstunnel.__DOMAIN_RAW__`)'
      priority: 100
      middlewares:
        - geo-allow
      service: wstunnel
      tls:
        certResolver: le
        options: mtls-tunnel

    # Tunnel health probe. A dedicated always-200 responder lives in the
    # home-client stack and is exposed over a SECOND reverse listener on
    # wstunnel:8444. A clean 200 here means the tunnel WebSocket is up end-to-end
    # (client -> VPS -> tunnel -> home) — unlike wstunnel.DOMAIN, which only 400s a
    # non-upgrade request and only proves the VPS server is alive. No mTLS here (so
    # a plain HTTP monitor like Uptime Kuma can hit it and get 200), so unlike the
    # control-plane router it isn't pinned to a known peer — geo-allow limits it to
    # your country and crowdsec scores it like the public poly route, leaving no
    # open, unscored route. Higher priority than the poly catch-all, whose
    # HostRegexp would otherwise also match this host.
    wstunnel-health:
      entryPoints:
        - websecure
      rule: 'Host(`wstunnel-health.__DOMAIN_RAW__`)'
      priority: 100
      middlewares:
        - geo-allow
        - crowdsec
      service: wstunnel-health
      tls:
        certResolver: le

    # All *.DOMAIN over HTTPS: terminate TLS here, geo-check, CrowdSec-check,
    # then re-encrypt to the home server.
    poly:
      entryPoints:
        - websecure
      rule: 'HostRegexp(`^.+\.__DOMAIN__$`)'
      middlewares:
        - geo-allow
        - crowdsec
      service: home-server
      tls:
        certResolver: le
        # Ask ACME for a single wildcard cert that covers every subdomain.
        domains:
          - main: "__DOMAIN_RAW__"
            sans:
              - "*.__DOMAIN_RAW__"

  middlewares:
    # Geofencing. blackListMode=false => only `countries` may connect (allowlist);
    # =true => `countries` are blocked (blocklist). This VPS is the internet edge,
    # so the request's real client IP is used directly (XForwardedForReverseProxy
    # stays false — don't trust a client-supplied X-Forwarded-For here).
    geo-allow:
      plugin:
        geoblock:
          silentStartUp: false
          allowLocalRequests: true
          logAllowedRequests: false
          logApiRequests: false
          api: "https://get.geojs.io/v1/ip/country/{ip}"
          apiTimeoutMs: 750
          cacheSize: 1024
          forceMonthlyUpdate: false
          allowUnknownCountries: false
          blackListMode: __GEO_BLACKLIST__
          addCountryHeader: true
          httpStatusCodeDeniedRequest: 403
          countries: [__GEO_COUNTRIES__]

    # CrowdSec L7 bouncer, live mode: every request's IP is checked against the
    # CrowdSec engine's decisions (community blocklist + Traefik-log scenarios).
    crowdsec:
      plugin:
        bouncer:
          enabled: true
          crowdsecMode: live
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKey: "__CROWDSEC_LAPI_KEY__"

  services:
    # WebSocket upgrade target for the tunnel control plane. `http` scheme — Traefik
    # transparently handles the ws upgrade; TLS/mTLS were already terminated at the
    # edge, so wstunnel listens plaintext ws on :8080 inside its container.
    wstunnel:
      loadBalancer:
        servers:
          - url: "http://wstunnel:8080"

    # Health responder reached over the second reverse listener
    # (wstunnel:8444 -> tunnel -> home 127.0.0.1:8880 -> whoami). Plain http — the
    # far end is a bare always-200 container with no TLS of its own.
    wstunnel-health:
      loadBalancer:
        servers:
          - url: "http://wstunnel:8444"

    home-server:
      loadBalancer:
        # Re-encrypt to the home server, reached through the wstunnel reverse
        # listener (wstunnel:8443 -> tunnel -> home Traefik :443), which still
        # terminates its own TLS.
        servers:
          - url: "https://wstunnel:8443"
        serversTransport: home-tls

  serversTransports:
    # The hop to the home server rides inside the wstunnel WebSocket (TLS on the
    # wire to the edge), and the home server presents its own cert for its own
    # names, so we don't verify it from here.
    home-tls:
      insecureSkipVerify: true

# Edge mTLS for the wstunnel router: Traefik requires and verifies a client
# certificate signed by our private Certificate Authority (CA) — the trust
# anchor we generate ourselves — before completing the TLS handshake on
# wstunnel.DOMAIN. The CA cert is mounted at /etc/traefik/mtls (see
# docker-compose.yml); the matching client cert+key live only on the home box.
tls:
  options:
    mtls-tunnel:
      clientAuth:
        caFiles:
          - /etc/traefik/mtls/tunnel-ca.crt
        clientAuthType: RequireAndVerifyClientCert
