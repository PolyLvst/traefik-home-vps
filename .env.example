# Copy to .env and fill in your values:  cp .env.example .env
#
# Base domain served through this proxy. All *.DOMAIN hostnames are passed
# through to the home server (e.g. app.poly.my.id, git.poly.my.id, ...).
DOMAIN=poly.my.id
#
# Tailscale IP (100.x.y.z) of the home server that terminates TLS and serves the
# *.DOMAIN apps. Use the IP, not a MagicDNS name — MagicDNS won't resolve inside
# the container on the default bridge network.
HOME_SERVER=100.x.y.z
#
# Optional: CrowdSec console enrollment key (app.crowdsec.net) for a web UI over
# the engine. Leave unset to run standalone. If set, also uncomment the
# ENROLL_* lines on the crowdsec service in docker-compose.yml.
# CROWDSEC_ENROLL_KEY=
#
# ─── TLS termination on the VPS (bridging) ───────────────────────────────────
# The VPS now decrypts *.DOMAIN traffic, so it needs its own wildcard cert from
# Let's Encrypt via a DNS-01 challenge.
#
# Contact e-mail for the Let's Encrypt account.
ACME_EMAIL=you@example.com
# Cloudflare API token (scoped: Zone → DNS → Edit on your domain's zone) used to
# answer the DNS-01 challenge for *.DOMAIN.
# Using a DIFFERENT DNS provider? Change the provider in docker-compose.yml
# (--certificatesresolvers.le.acme.dnschallenge.provider=cloudflare) and set that
# provider's env vars instead — see https://go-acme.github.io/lego/dns/
CF_DNS_API_TOKEN=
#
# ─── Geofencing (GeoBlock plugin) ────────────────────────────────────────────
# false = allowlist: ONLY GEO_COUNTRIES may connect (everything else is blocked).
# true  = blocklist: GEO_COUNTRIES are blocked, everything else is allowed.
GEO_BLACKLIST=false
# ISO 3166-1 alpha-2 codes, comma-separated (rendered into a YAML flow list).
# e.g. "ID" or "ID, SG, MY".
GEO_COUNTRIES=ID
#
# ─── CrowdSec Traefik bouncer (L7) ───────────────────────────────────────────
# API key for the in-Traefik CrowdSec bouncer plugin. Create it AFTER the engine
# is up:  docker compose exec crowdsec cscli bouncers add traefik-plugin
CROWDSEC_LAPI_KEY=
